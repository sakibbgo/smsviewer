<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="SMS Buddy"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/statusLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/statusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/dot_red" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline"
            android:textColor="#AA0000"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/permissionIndicators"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/permSms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#E8F5E9"
            android:padding="4dp"
            android:text="SMS ✔"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/smsAllowBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#2E5EB8"
            android:padding="0dp"
            android:text="🔓"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/permSim1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#E3F2FD"
            android:padding="4dp"
            android:text="S1 ✔"
            android:textColor="#1565C0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/permSim2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#E3F2FD"
            android:padding="4dp"
            android:text="S2 ✔"
            android:textColor="#1565C0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/permNet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#FFF3E0"
            android:padding="4dp"
            android:text="NET ✔"
            android:textColor="#EF6C00"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/permBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#FCE4EC"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:text="BAT ⚠"
            android:textColor="#C2185B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/screenBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#2E5EB8"
            android:padding="0dp"
            android:text="⏱"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIM1"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/sim1Number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter 11-digit number"
                android:inputType="phone"
                android:maxLength="11"
                android:padding="8dp" />

            <Button
                android:id="@+id/sim1SaveBtn"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="#2E5EB8"
                android:text="Save"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIM2"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/sim2Number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter 11-digit number"
                android:inputType="phone"
                android:maxLength="11"
                android:padding="8dp" />

            <Button
                android:id="@+id/sim2SaveBtn"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="#2E5EB8"
                android:text="Save"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/card_bg"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/listenBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#41B619"
            android:text="Start Listening"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/clearLogsBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#D2691E"
            android:text="Clear Logs"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/smsLogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMS Logs (0)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/smsLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No SMS logs yet"
                android:textColor="#888888"
                android:textSize="15sp" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>