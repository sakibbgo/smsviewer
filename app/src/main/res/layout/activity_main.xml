<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F7F7F7">

    <!-- Title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SMS Buddy"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="0dp"/>

    <!-- Status bar -->
    <LinearLayout
        android:id="@+id/statusLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/statusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_red"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline"
            android:textSize="16sp"
            android:textColor="#AA0000"/>
    </LinearLayout>

    <!-- SIM card section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIM1"
            android:textStyle="bold"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="2dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/sim1Number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter 11-digit number"
                android:inputType="phone"
                android:maxLength="11"
                android:background="@android:drawable/edit_text"
                android:padding="8dp"/>

            <Button
                android:id="@+id/sim1SaveBtn"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Save"
                android:layout_marginStart="8dp"
                android:backgroundTint="#2E5EB8"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIM2"
            android:textStyle="bold"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="2dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="0dp">

            <EditText
                android:id="@+id/sim2Number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter 11-digit number"
                android:inputType="phone"
                android:maxLength="11"
                android:background="@android:drawable/edit_text"
                android:padding="8dp"/>

            <Button
                android:id="@+id/sim2SaveBtn"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Save"
                android:layout_marginStart="8dp"
                android:backgroundTint="#2E5EB8"
                android:textColor="@android:color/white"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Start/Stop listening and Clear Logs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/card_bg"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/listenBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start Listening"
            android:backgroundTint="#41B619"
            android:textColor="@android:color/white"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/clearLogsBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clear Logs"
            android:backgroundTint="#D2691E"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <!-- SMS Log card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="12dp"
        android:layout_marginBottom="0dp">

        <TextView
            android:id="@+id/smsLogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMS Logs (0)"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/smsLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No SMS logs yet"
                android:textSize="15sp"
                android:textColor="#888888"/>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
